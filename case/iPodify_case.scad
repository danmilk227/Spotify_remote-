// ═══════════════════════════════════════════════════════════════════
//  iPodify ESP32-C3 SuperMini — 3D Printed Case  v1.0
//  Parametric OpenSCAD
//
//  КОМПОНЕНТЫ:
//    • ESP32-C3 SuperMini  22.5 × 18 × 3.3 мм (USB-C на короткой стороне)
//    • OLED SSD1306 0.96"  PCB ~27 × 27 мм
//    • Мышиный энкодер     колесо Ø ≈ 20 мм, ширина ≈ 10 мм
//    • Кнопки тактовые 6×6 высота 3.5 мм (до кнопки), 5 мм (с кнопкой)
//
//  ПЕЧАТЬ:
//    0.2 мм слой · 3 периметра · 20% заполнение · PLA / PETG
//    front_shell и back_cover — печатаются отдельно
//    СБОРКА: 4× винт M2.5 × 8 мм (самонарезающий в бобышки)
//
//  БЫСТРАЯ НАСТРОЙКА ПЕРЕД ПЕЧАТЬЮ:
//    1. OLED_CY       — смещение экрана по вертикали
//    2. SO_XS / SO_CY — позиция стоек под ESP32 (замерь отверстия платы)
//    3. USB_Z         — высота USB-C от задней стенки
//    4. ENC_SW/SH     — ширина/высота слота под колесо энкодера
// ═══════════════════════════════════════════════════════════════════

$fn = 48;  // плавность цилиндров (увеличь до 64 перед финальным экспортом)

// ─── Габариты корпуса ──────────────────────────────────────────────
CW   = 62;      // ширина  мм
CH   = 115;     // высота  мм
CD   = 24;      // глубина мм  (задняя стенка = Z0, передняя = Z=CD)
WALL = 2.5;     // толщина стенок / дна
CR   = 9;       // радиус скругления углов

// ─── OLED 0.96" SSD1306 ───────────────────────────────────────────
OLED_PCB_W = 27;    // ширина PCB модуля  (подгони под свой)
OLED_PCB_H = 27;    // высота PCB модуля
OLED_WIN_W = 24;    // окно дисплея — ширина
OLED_WIN_H = 13;    // окно дисплея — высота
OLED_CY    = 20;    // центр окна, мм от верха корпуса

// ─── 4× тактовые кнопки 6×6 мм ───────────────────────────────────
BTN_ROW_CY = 52;                        // центр ряда, мм от верха
BTN_D      = 6.5;                       // Ø отверстия под палец
BTN_XS     = [-19.5, -6.5, 6.5, 19.5]; // X: PREV  MENU  PLAY  NEXT

// ─── Область колеса / энкодера ────────────────────────────────────
RING_CY    = 85;    // центр декор. кольца, мм от верха
RING_OD    = 46;    // внешний Ø кольца
RING_ID    = 42;    // внутренний Ø кольца (канавка 2 мм)
RING_DEPTH = 1.0;   // глубина гравировки канавки

CTR_CY     = 72;    // CENTER (OK) кнопка, центр мм от верха
CTR_D      = 8;     // Ø отверстия под CENTER кнопку

ENC_CY     = 97;    // центр слота колеса энкодера, мм от верха
ENC_SW     = 12;    // ширина слота (ширина колеса ~10 мм + допуск 2 мм)
ENC_SH     = 23;    // высота слота (Ø колеса   ~20 мм + допуск 3 мм)

// ─── USB-C (нижний торец) ─────────────────────────────────────────
USB_W = 10;     // ширина выреза
USB_H =  4.5;   // высота выреза
USB_Z = 10;     // центр выреза по Z от задней стенки
                // ► подбери так, чтобы совпасть с портом платы

// ─── Угловые бобышки под винты M2.5 ──────────────────────────────
BOSS_OD = 6;
BOSS_ID = 2.6;                     // Ø отверстия под M2.5
BOSS_H  = CD - WALL*2 - 1;        // высота бобышки
BOSS_MX = CW/2 - 7;               // X от центра
BOSS_MY = CH/2 - 7;               // Y от центра

// ─── Стойки под ESP32-C3 SuperMini ───────────────────────────────
// Плата ориентирована USB-C вниз (к нижнему торцу корпуса).
// SO_XS — X-координаты монтажных отверстий платы (замерь!).
// На SuperMini отверстия ≈ ±7 мм от центра.
SO_OD  = 4.5;           // внешний Ø стойки
SO_ID  = 2.1;           // Ø отверстия под M2
SO_H   = 5;             // высота стойки от дна
SO_XS  = [-7.0, 7.0];  // X позиции (подгони под свою плату)
SO_CY  = 100;           // центр ряда стоек, мм от верха

// ══════════════════════════════════════════════════════════════════
//  ВСПОМОГАТЕЛЬНЫЕ МОДУЛИ
// ══════════════════════════════════════════════════════════════════

// Скруглённый параллелепипед, начинается с Z=0
module rbox(w, h, d, r) {
    hull()
        for (xs = [-1,1], ys = [-1,1])
            translate([xs*(w/2 - r), ys*(h/2 - r), 0])
                cylinder(r=r, h=d);
}

// Смещение от верха → координата Y (корпус центрирован в начале)
function ytop(dt) = CH/2 - dt;

// Стадион (скруглённый прямоугольник), начинается с Z=0
module stadium(sw, sh, h) {
    hull()
        for (ys = [-1, 1])
            translate([0, ys * (sh - sw) / 2, 0])
                cylinder(d=sw, h=h);
}

// ══════════════════════════════════════════════════════════════════
//  ПЕРЕДНЯЯ ПОЛОВИНА КОРПУСА
// ══════════════════════════════════════════════════════════════════
module front_shell() {

    difference() {

        // 1. Внешний объём
        rbox(CW, CH, CD, CR);

        // 2. Внутренняя полость (открыта сзади, передняя стенка цела)
        rbox(CW - WALL*2, CH - WALL*2, CD - WALL + 0.01, CR - WALL);

        // 3. Окно дисплея OLED
        translate([-OLED_WIN_W/2,
                   ytop(OLED_CY) - OLED_WIN_H/2,
                   CD - WALL - 0.1])
            cube([OLED_WIN_W, OLED_WIN_H, WALL + 0.2]);

        // 4. Карман под PCB модуля OLED (1 мм вглубь передней стенки)
        //    Удерживает модуль без клея, дисплей вровень с окном
        translate([-OLED_PCB_W/2,
                   ytop(OLED_CY) - OLED_PCB_H/2,
                   CD - WALL])
            cube([OLED_PCB_W, OLED_PCB_H, 1.1]);

        // 5. Отверстия кнопок  PREV · MENU · PLAY · NEXT
        for (bx = BTN_XS)
            translate([bx, ytop(BTN_ROW_CY), CD - WALL - 0.1])
                cylinder(d=BTN_D, h=WALL + 0.2);

        // 6. Декоративная канавка кольца
        translate([0, ytop(RING_CY), CD - RING_DEPTH - 0.1])
            difference() {
                cylinder(d=RING_OD, h=RING_DEPTH + 0.2, $fn=64);
                cylinder(d=RING_ID, h=RING_DEPTH + 0.4, $fn=64);
            }

        // 7. Отверстие кнопки CENTER (OK)
        translate([0, ytop(CTR_CY), CD - WALL - 0.1])
            cylinder(d=CTR_D, h=WALL + 0.2);

        // 8. Слот колеса мышиного энкодера (форма стадиона)
        //    Колесо торчит через переднюю стенку — прокручиваешь пальцем
        translate([0, ytop(ENC_CY), CD - WALL - 0.1])
            stadium(ENC_SW, ENC_SH, WALL + 0.2);

        // 9. Вырез USB-C в нижнем торце
        translate([-USB_W/2, -CH/2 - 0.1, USB_Z - USB_H/2])
            cube([USB_W, WALL + 0.2, USB_H]);

        // 10. Сквозные отверстия под винты в передней стенке
        for (xs = [-1,1], ys = [-1,1])
            translate([xs*BOSS_MX, ys*BOSS_MY, CD - WALL - 0.1])
                cylinder(d=BOSS_ID, h=WALL + 0.2);
    }

    // ── Бобышки для винтов M2.5 (растут от дна внутри) ───────────
    for (xs = [-1,1], ys = [-1,1])
        translate([xs*BOSS_MX, ys*BOSS_MY, WALL])
            difference() {
                cylinder(d=BOSS_OD, h=BOSS_H, $fn=20);
                cylinder(d=BOSS_ID, h=BOSS_H + 0.1, $fn=16);
            }

    // ── Стойки под ESP32-C3 SuperMini ────────────────────────────
    for (sox = SO_XS)
        translate([sox, ytop(SO_CY), WALL])
            difference() {
                cylinder(d=SO_OD, h=SO_H, $fn=20);
                cylinder(d=SO_ID, h=SO_H + 0.1, $fn=16);
            }
}

// ══════════════════════════════════════════════════════════════════
//  ЗАДНЯЯ КРЫШКА
// ══════════════════════════════════════════════════════════════════
module back_cover() {
    difference() {
        rbox(CW, CH, WALL, CR);

        // Отверстия под винты M2.5 с зенкером
        for (xs = [-1,1], ys = [-1,1])
            translate([xs*BOSS_MX, ys*BOSS_MY, 0]) {
                cylinder(d=BOSS_ID, h=WALL + 0.1);
                translate([0, 0, WALL - 0.8])
                    cylinder(d1=BOSS_ID, d2=BOSS_ID + 3, h=0.9, $fn=16);
            }
    }

    // Позиционирующий бортик (вставляется в корпус, зазор 0.15 мм)
    difference() {
        translate([0, 0, WALL])
            rbox(CW - WALL*2 - 0.3, CH - WALL*2 - 0.3, 1.5, CR - WALL);
        translate([0, 0, WALL - 0.1])
            rbox(CW - WALL*2 - 2.3, CH - WALL*2 - 2.3, 2.0, CR - WALL);
    }
}

// ══════════════════════════════════════════════════════════════════
//  РЕНДЕР — раскомментируй нужное, потом File → Export → Export as STL
// ══════════════════════════════════════════════════════════════════

front_shell();
