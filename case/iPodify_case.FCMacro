# -*- coding: utf-8 -*-
"""
=============================================================
 iPodify ESP32-C3 SuperMini — FreeCAD Case Macro  v1.0
=============================================================
 ЗАПУСК: Macro → Macros → ... → Launch  (или открой этот файл через
         Macro → Open и нажми кнопку ► "Execute macro")

 ЭКСПОРТ STL:
   1. Выдели объект FrontShell в дереве
   2. File → Export → STL Mesh (*.stl)
   3. Повтори для BackCover

 КОМПОНЕНТЫ:
   • ESP32-C3 SuperMini  22.5 × 18 × 3.3 мм (USB-C на короткой стороне)
   • OLED SSD1306 0.96"  PCB ≈ 27 × 27 мм
   • Мышиный энкодер     колесо Ø ≈ 20 мм, ширина ≈ 10 мм
   • Тактовые кнопки 6×6 высота 3.5 мм (тело) / 5 мм (с колпачком)
   • Сборка: 4× винт M2.5 × 8 мм самонарезающий

 ЧТО ПОДОГНАТЬ ПЕРЕД ПЕЧАТЬЮ:
   1. OLED_CY       — вертикальное положение экрана (мм от верха)
   2. SO_XS / SO_CY — позиция стоек ESP32 (замерь отверстия платы)
   3. USB_Z         — высота центра USB-C порта от задней стенки
   4. ENC_SW/SH     — ширина/высота слота колеса (замерь колесо + 2 мм)
=============================================================
"""

import FreeCAD
import Part
import math
from FreeCAD import Base


# ══════════════════════════════════════════════════════════════
#  ПАРАМЕТРЫ — изменяй здесь
# ══════════════════════════════════════════════════════════════

# Габариты корпуса
CW   = 62.0    # ширина  мм
CH   = 115.0   # высота  мм
CD   = 24.0    # глубина мм  (Z=0 — задняя стенка, Z=CD — передняя)
WALL = 2.5     # толщина стенок
CR   = 9.0     # радиус скругления углов

# OLED 0.96" SSD1306
OLED_PCB_W = 27.0    # ширина PCB модуля  (подгони под свой)
OLED_PCB_H = 27.0    # высота PCB модуля
OLED_WIN_W = 24.0    # ширина окна дисплея
OLED_WIN_H = 13.0    # высота окна дисплея
OLED_CY    = 20.0    # центр окна — мм от верха корпуса

# 4× кнопки тактовые 6×6 мм
BTN_ROW_CY = 52.0                        # центр ряда — мм от верха
BTN_D      = 6.5                         # Ø отверстия под палец
BTN_XS     = [-19.5, -6.5, 6.5, 19.5]  # X-координаты: PREV  MENU  PLAY  NEXT

# Декоративное кольцо / область колеса энкодера
RING_CY    = 85.0    # центр кольца — мм от верха
RING_OD    = 46.0    # внешний Ø кольца
RING_ID    = 42.0    # внутренний Ø (канавка 2 мм)
RING_DEPTH = 1.0     # глубина гравировки

CTR_CY = 72.0        # CENTER (OK) кнопка — мм от верха
CTR_D  = 8.0         # Ø отверстия

ENC_CY = 97.0        # центр слота энкодера — мм от верха
ENC_SW = 12.0        # ширина слота (ширина колеса ~10 мм + 2 мм допуск)
ENC_SH = 23.0        # высота слота (Ø колеса ~20 мм + 2 мм допуск)

# USB-C (нижний торец корпуса)
USB_W = 10.0
USB_H =  4.5
USB_Z = 10.0    # центр выреза по Z от задней стенки — подгони под плату!

# Угловые бобышки под винты M2.5
BOSS_OD = 6.0
BOSS_ID = 2.6              # Ø отверстия под M2.5 самонарезающий
BOSS_H  = CD - WALL*2 - 1.0
BOSS_MX = CW / 2.0 - 7.0  # X от центра корпуса
BOSS_MY = CH / 2.0 - 7.0  # Y от центра корпуса

# Стойки под ESP32-C3 SuperMini
# Плата ориентирована: USB-C вниз (к нижнему торцу корпуса)
SO_OD = 4.5
SO_ID = 2.1              # Ø под M2
SO_H  = 5.0              # высота стоек от дна
SO_XS = [-7.0, 7.0]     # X стоек (расстояние между монт. отверстиями платы ≈ 14 мм)
SO_CY = 100.0            # центр ряда — мм от верха


# ══════════════════════════════════════════════════════════════
#  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ══════════════════════════════════════════════════════════════

def v(x, y, z=0.0):
    """Краткий вектор."""
    return Base.Vector(x, y, z)


def ytop(dt):
    """Расстояние от верха → Y-координата (корпус центрирован в начале)."""
    return CH / 2.0 - dt


def make_rbox(w, h, d, r):
    """
    Скруглённый параллелепипед, центрирован в XY, Z от 0 до d.
    Строится как экструзия замкнутого wire из 4 линий + 4 дуг (по 90°).
    """
    SQ45 = r * math.sqrt(2.0) / 2.0   # смещение до середины дуги
    hW, hH = w / 2.0, h / 2.0
    cx, cy  = hW - r, hH - r

    def seg(x0, y0, x1, y1):
        return Part.LineSegment(v(x0, y0), v(x1, y1)).toShape()

    def arc3(x0, y0, xm, ym, x1, y1):
        return Part.Arc(v(x0, y0), v(xm, ym), v(x1, y1)).toShape()

    # Контур против часовой стрелки
    edges = [
        seg(   cx, -hH, -cx, -hH),                               # низ →
        arc3( -cx, -hH, -cx - SQ45, -cy - SQ45, -hW, -cy),      # угол НЛ
        seg(  -hW,  -cy, -hW,  cy),                              # лево ↑
        arc3( -hW,   cy, -cx - SQ45,  cy + SQ45, -cx, hH),      # угол ВЛ
        seg(  -cx,  hH,  cx, hH),                                # верх →
        arc3(  cx,  hH,  cx + SQ45,  cy + SQ45,  hW, cy),       # угол ВП
        seg(   hW,  cy,  hW, -cy),                               # право ↓
        arc3(  hW, -cy,  cx + SQ45, -cy - SQ45,  cx, -hH),      # угол НП
    ]
    wire = Part.Wire(edges)
    face = Part.Face(wire)
    return face.extrude(v(0, 0, d))


def make_cyl(diameter, h, x=0.0, y=0.0, z=0.0):
    """Цилиндр: диаметр, высота, позиция центра основания."""
    return Part.makeCylinder(diameter / 2.0, h, v(x, y, z))


def make_stadium(sw, sh, h, x=0.0, y=0.0, z=0.0):
    """
    Слот-стадион (прямоугольник со скруглёнными торцами).
    sw=ширина, sh=полная высота, h=глубина. Центр в (x,y), низ на z.
    """
    r  = sw / 2.0
    hl = (sh - sw) / 2.0   # расстояние центр → центр полуокружности

    br = v(x + r, y - hl, z);  tr = v(x + r, y + hl, z)
    tl = v(x - r, y + hl, z);  bl = v(x - r, y - hl, z)
    top_mid = v(x, y + hl + r, z)
    bot_mid = v(x, y - hl - r, z)

    edges = [
        Part.LineSegment(br, tr).toShape(),
        Part.Arc(tr, top_mid, tl).toShape(),
        Part.LineSegment(tl, bl).toShape(),
        Part.Arc(bl, bot_mid, br).toShape(),
    ]
    wire = Part.Wire(edges)
    face = Part.Face(wire)
    return face.extrude(v(0, 0, h))


# ══════════════════════════════════════════════════════════════
#  ПЕРЕДНЯЯ ПОЛОВИНА КОРПУСА
# ══════════════════════════════════════════════════════════════

def build_front_shell():
    FreeCAD.Console.PrintMessage("[1/10] Outer body...\n")
    shell = make_rbox(CW, CH, CD, CR)

    FreeCAD.Console.PrintMessage("[2/10] Inner cavity...\n")
    shell = shell.cut(
        make_rbox(CW - WALL*2, CH - WALL*2, CD - WALL + 0.01, CR - WALL))

    FreeCAD.Console.PrintMessage("[3/10] OLED window + PCB pocket...\n")
    # Сквозное окно дисплея
    shell = shell.cut(Part.makeBox(
        OLED_WIN_W, OLED_WIN_H, WALL + 0.2,
        v(-OLED_WIN_W/2, ytop(OLED_CY) - OLED_WIN_H/2, CD - WALL - 0.1)))
    # Карман 1 мм под PCB модуля — держит без клея
    shell = shell.cut(Part.makeBox(
        OLED_PCB_W, OLED_PCB_H, 1.1,
        v(-OLED_PCB_W/2, ytop(OLED_CY) - OLED_PCB_H/2, CD - WALL)))

    FreeCAD.Console.PrintMessage("[4/10] Button holes (PREV MENU PLAY NEXT)...\n")
    for bx in BTN_XS:
        shell = shell.cut(
            make_cyl(BTN_D, WALL + 0.2, bx, ytop(BTN_ROW_CY), CD - WALL - 0.1))

    FreeCAD.Console.PrintMessage("[5/10] Decorative ring groove...\n")
    ring = make_cyl(RING_OD, RING_DEPTH + 0.2, 0, ytop(RING_CY), CD - RING_DEPTH - 0.1)
    ring = ring.cut(
        make_cyl(RING_ID, RING_DEPTH + 0.4, 0, ytop(RING_CY), CD - RING_DEPTH - 0.1))
    shell = shell.cut(ring)

    FreeCAD.Console.PrintMessage("[6/10] CENTER button hole...\n")
    shell = shell.cut(
        make_cyl(CTR_D, WALL + 0.2, 0, ytop(CTR_CY), CD - WALL - 0.1))

    FreeCAD.Console.PrintMessage("[7/10] Encoder wheel slot...\n")
    shell = shell.cut(
        make_stadium(ENC_SW, ENC_SH, WALL + 0.2, 0, ytop(ENC_CY), CD - WALL - 0.1))

    FreeCAD.Console.PrintMessage("[8/10] USB-C cutout...\n")
    shell = shell.cut(Part.makeBox(
        USB_W, WALL + 0.2, USB_H,
        v(-USB_W / 2, -CH / 2 - 0.1, USB_Z - USB_H / 2)))

    FreeCAD.Console.PrintMessage("[9/10] Screw bosses...\n")
    for xs in [-1, 1]:
        for ys in [-1, 1]:
            x, y = xs * BOSS_MX, ys * BOSS_MY
            # Сквозное отверстие в передней стенке
            shell = shell.cut(make_cyl(BOSS_ID, WALL + 0.2, x, y, CD - WALL - 0.1))
            # Бобышка внутри
            boss = make_cyl(BOSS_OD, BOSS_H, x, y, WALL)
            boss = boss.cut(make_cyl(BOSS_ID, BOSS_H + 0.1, x, y, WALL))
            shell = shell.fuse(boss)

    FreeCAD.Console.PrintMessage("[10/10] ESP32 standoffs...\n")
    for sox in SO_XS:
        so = make_cyl(SO_OD, SO_H, sox, ytop(SO_CY), WALL)
        so = so.cut(make_cyl(SO_ID, SO_H + 0.1, sox, ytop(SO_CY), WALL))
        shell = shell.fuse(so)

    return shell


# ══════════════════════════════════════════════════════════════
#  ЗАДНЯЯ КРЫШКА
# ══════════════════════════════════════════════════════════════

def build_back_cover():
    FreeCAD.Console.PrintMessage("[1/3] Back cover base...\n")
    cover = make_rbox(CW, CH, WALL, CR)

    FreeCAD.Console.PrintMessage("[2/3] Screw holes + countersinks...\n")
    for xs in [-1, 1]:
        for ys in [-1, 1]:
            x, y = xs * BOSS_MX, ys * BOSS_MY
            cover = cover.cut(make_cyl(BOSS_ID, WALL + 0.1, x, y, 0))
            # Зенкер под головку винта
            csink = Part.makeCone(BOSS_ID / 2, (BOSS_ID + 3) / 2, 0.9,
                                  v(x, y, WALL - 0.8))
            cover = cover.cut(csink)

    FreeCAD.Console.PrintMessage("[3/3] Location lip...\n")
    lip = make_rbox(CW - WALL*2 - 0.3, CH - WALL*2 - 0.3, 1.5, CR - WALL)
    lip.translate(v(0, 0, WALL))
    lip_cut = make_rbox(CW - WALL*2 - 2.3, CH - WALL*2 - 2.3, 2.0, CR - WALL)
    lip_cut.translate(v(0, 0, WALL - 0.1))
    cover = cover.fuse(lip.cut(lip_cut))

    return cover


# ══════════════════════════════════════════════════════════════
#  ЗАПУСК
# ══════════════════════════════════════════════════════════════

FreeCAD.Console.PrintMessage("=== iPodify Case: START ===\n")

doc = FreeCAD.newDocument("iPodify_Case")

# ─── Передний корпус ────────────────────────────────────────
FreeCAD.Console.PrintMessage(">>> Building FrontShell (may take 30-60 sec)...\n")
front = build_front_shell()
obj_f = doc.addObject("Part::Feature", "FrontShell")
obj_f.Shape = front
obj_f.ViewObject.ShapeColor = (0.95, 0.95, 0.95)
FreeCAD.Console.PrintMessage(">>> FrontShell OK\n")

# ─── Задняя крышка (раскомментируй при необходимости) ───────
# FreeCAD.Console.PrintMessage(">>> Building BackCover...\n")
# back = build_back_cover()
