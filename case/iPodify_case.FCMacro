# obj_b.Shape = back
# obj_b.ViewObject.ShapeColor = (0.75, 0.75, 0.75)
# obj_b.ViewObject.Visibility = False
# FreeCAD.Console.PrintMessage(">>> BackCover OK\n")

doc.recompute()

try:
    import FreeCADGui
    FreeCADGui.activeDocument().activeView().viewIsometric()
    FreeCADGui.SendMsgToActiveView("ViewFit")
except Exception:
    pass

FreeCAD.Console.PrintMessage("=== iPodify Case: DONE ===\n")
FreeCAD.Console.PrintMessage("Экспорт STL: выдели объект → File → Export → STL Mesh\n")
