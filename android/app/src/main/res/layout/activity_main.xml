<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="iPodify Remote Bridge"
        android:textColor="#1DB954"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Фоновая служба авто-подключения к ESP32"
        android:textColor="#A1A1AA"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:padding="16dp"
        android:text="Статус: Инициализация..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:padding="14dp"
        android:text="Проверка разрешений..."
        android:textColor="#E4E4E7"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnGrantPerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Предоставить Bluetooth доступ"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnNotifAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Разрешить доступ к медиа (Spotify)"
        android:backgroundTint="#1DB954"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSpotifyLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Авторизовать Spotify (для плейлистов)"
        android:backgroundTint="#1DB954"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Перезапустить службу"
        android:backgroundTint="#27272A"
        android:textColor="#FFFFFF" />

</LinearLayout>
